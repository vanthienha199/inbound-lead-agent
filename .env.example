# Which backend writes the reply: template | anthropic | claude_cli
# template needs no key and is deterministic, which is what the tests assert on.
AGENT_BACKEND=template

# Needed only when AGENT_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me
AGENT_MODEL=claude-haiku-4-5-20251001

# Score at or above this pauses the run for a person before anything is sent
APPROVAL_THRESHOLD=65
